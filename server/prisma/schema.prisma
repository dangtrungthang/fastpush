generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  apps      App[]
  createdAt DateTime @default(now())
}

model App {
  id            String    @id @default(uuid())
  name          String
  platform      String
  deploymentKey String    @unique @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  releases      Release[]
  createdAt     DateTime  @default(now())

  @@unique([name, userId])
}

model Release {
  id              String         @id @default(uuid())
  appId           String
  app             App            @relation(fields: [appId], references: [id])
  version         Int
  targetVersion   String
  type            String
  filePath        String
  fileSize        Int
  hash            String
  description     String?
  isMandatory     Boolean        @default(false)
  isDisabled      Boolean        @default(false)
  rolloutPercent  Int            @default(100)
  downloadCount   Int            @default(0)
  installCount    Int            @default(0)
  failCount       Int            @default(0)
  rolledBackAt    DateTime?
  rolledBackFrom  String?
  createdAt       DateTime       @default(now())
  deviceInstalls  DeviceInstall[]
}

model DeviceInstall {
  id         String   @id @default(uuid())
  releaseId  String
  release    Release  @relation(fields: [releaseId], references: [id])
  deviceId   String
  appVersion String
  status     String   @default("pending")  // pending | downloading | installed | failed
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([releaseId, deviceId])
}
